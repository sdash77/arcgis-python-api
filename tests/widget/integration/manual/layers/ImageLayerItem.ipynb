   "source": [
    "from arcgis.gis import GIS\n",
    "gis = GIS()\n",
    "items = gis.content.search(\"Landsat 8 Views\", \"Imagery Layer\", max_items=2)\n",
    "landast_item = items[0]\n",
    "imglyr = landast_item.layers[0]\n",
    "map = gis.map()\n",
    "map.add_layer(imglyr)\n",
    "map"
   ]
  },
