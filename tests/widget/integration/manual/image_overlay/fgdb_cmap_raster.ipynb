   "source": [
    "from arcgis.gis import GIS\n",
    "from arcgis.raster import Raster\n",
    "gis = GIS()\n",
    "raster = Raster(\"./data/madison_wi.gdb/Impervious_Surfaces\",\n",
    "                cmap = \"OrRd\",\n",
    "                opacity = 0.5)\n",
    "map = gis.map(\"Madison, WI\")\n",
    "map.add_layer(raster)\n",
    "map"
   ]
