{
    "name": "ArcGIS Conda",
    "image": "mcr.microsoft.com/devcontainers/universal:2",
    "features": {
      "ghcr.io/devcontainers/features/conda:1": {}
    },
    "remoteEnv": {
      "PYTHONPATH": "/workspaces/geosaurus/src:/workspaces/geosaurus/tests"
    },
    "postCreateCommand": "chmod +x ./.devcontainer/init_conda_env.sh && ./.devcontainer/init_conda_env.sh"
}